---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SITE } from "../../consts";

export async function getStaticPaths() {
  const studies = await getCollection("research", ({ data }) => !data.draft);
  return studies.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"research">;
}
const { entry } = Astro.props;
const { title, finding, summary, date, topic, tags, keyNumbers, figure, setup, limitations } = entry.data;
const { Content } = await render(entry);
const dateLabel = date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<Base title={title} description={summary}>
  <article class="mx-auto max-w-4xl px-5 py-12">
    <a href="/research" class="link-underline text-sm text-[var(--color-muted)] hover:text-[var(--color-ink)]"
      >← All research</a
    >

    <!-- Title + the one-sentence finding -->
    <header class="mt-8">
      <div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-1">
        <p class="kicker" style="color:var(--color-data)">{topic}</p>
        <time datetime={date.toISOString()} class="font-mono text-xs text-[var(--color-faint)]">{dateLabel}</time>
      </div>
      <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-[var(--color-ink)] sm:text-5xl">
        {title}
      </h1>
      <p class="mt-6 border-l-2 border-[var(--color-accent)] pl-4 text-lg leading-relaxed text-[var(--color-ink)]">
        {finding}
      </p>
    </header>

    <!-- Key numbers -->
    {
      keyNumbers.length > 0 && (
        <div class="mt-10 grid gap-4 sm:grid-cols-3">
          {keyNumbers.map((n) => (
            <div class="rounded-xl border border-[var(--color-border-solid)] bg-[var(--color-surface)] p-5">
              <p class="font-mono text-3xl font-bold tracking-tight text-[var(--color-ink)]">{n.value}</p>
              <p class="mt-2 text-sm leading-snug text-[var(--color-muted)]">{n.label}</p>
            </div>
          ))}
        </div>
      )
    }

    <!-- Main figure -->
    <figure class="mt-10">
      <a href={figure.src} target="_blank" rel="noopener" title="Open full size">
        <img
          src={figure.src}
          alt={figure.alt}
          loading="eager"
          class="w-full rounded-xl border border-[var(--color-border-solid)]"
        />
      </a>
      <figcaption class="mt-3 text-xs leading-relaxed text-[var(--color-faint)]">{figure.caption}</figcaption>
    </figure>

    <!-- The story -->
    <div class="research-prose mt-12">
      <Content />
    </div>

    <!-- Setup + limits: same layout for every study -->
    <section class="mt-14 grid gap-5 md:grid-cols-2">
      <div class="rounded-xl border border-[var(--color-border-solid)] bg-[var(--color-surface)] p-6">
        <h2 class="mb-4 text-lg font-semibold text-[var(--color-ink)]">How it was run</h2>
        <dl class="space-y-3 text-sm">
          {
            setup.map((s) => (
              <div>
                <dt class="font-mono text-xs uppercase tracking-wider text-[var(--color-faint)]">{s.label}</dt>
                <dd class="mt-0.5 leading-relaxed text-[var(--color-muted)]">{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="rounded-xl border border-[var(--color-border-solid)] bg-[var(--color-surface)] p-6">
        <h2 class="mb-4 text-lg font-semibold text-[var(--color-ink)]">Limits of this result</h2>
        <ul class="space-y-3">
          {
            limitations.map((line) => (
              <li class="flex gap-3 text-sm leading-relaxed text-[var(--color-muted)]">
                <span class="text-[var(--color-accent)]">▹</span>
                <span>{line}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <div class="mt-8 flex flex-wrap gap-1.5">
      {
        tags.map((tag) => (
          <span class="rounded-md bg-[var(--color-surface-2)] px-2.5 py-1 font-mono text-xs text-[var(--color-faint)]">
            {tag}
          </span>
        ))
      }
    </div>

    <!-- CTA -->
    <div class="mt-12 rounded-xl border border-[var(--color-border-solid)] bg-[var(--color-surface)] p-8">
      <h2 class="text-2xl font-bold tracking-tight text-[var(--color-ink)]">
        Want to know which lever moves your numbers?
      </h2>
      <p class="mt-2 text-[var(--color-muted)]">
        I build simulation models of real operations, so decisions rest on evidence before the budget is spent.
      </p>
      <a
        href={`mailto:${SITE.email}`}
        class="mt-5 inline-flex rounded-lg bg-[var(--color-accent)] px-5 py-2.5 text-sm font-semibold text-[#1a1206]"
        >{SITE.email}</a
      >
    </div>
  </article>
</Base>
